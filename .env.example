# Copia este archivo a .env.local y rellena los valores.
# Supabase → tu proyecto → Project Settings → API Keys
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública ("publishable", sb_publishable_...) o la clave "anon" antigua.
# Es segura en el navegador: los datos están protegidos por RLS.
# ¡Nunca pongas aquí la clave secreta / service_role!
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
